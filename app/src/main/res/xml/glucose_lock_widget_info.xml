<?xml version="1.0" encoding="utf-8"?>
<!-- Категория — в values/integers.xml. targetHost/widgetSize/widgetStyle — как у виджетов погоды на экране блокировки One UI -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:description="@string/lock_widget_description"
    android:initialKeyguardLayout="@layout/widget_lock"
    android:initialLayout="@layout/widget_lock"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_lock"
